{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": "error"
  },
  "ignorePatterns": [
    "**/node_modules/",
    "**/dist/",
    "**/coverage/",
    "docs/"
  ],
  "overrides": [
    {
      "files": [
        "packages/ask-user-question/**/*.ts"
      ],
      "rules": {
        "no-control-regex": "off"
      }
    }
  ]
}
