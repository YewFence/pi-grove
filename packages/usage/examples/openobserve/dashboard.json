            "show_legends": false,
            "legends_position": null,
            "decimals": 0,
            "top_results_others": false,
            "axis_border_show": false,
            "legend_width": { "unit": "px" },
            "base_map": { "type": "osm" },
            "map_view": { "zoom": 1, "lat": 0, "lng": 0 },
            "map_symbol_style": {
              "size": "by Value",
              "size_by_value": { "min": 1, "max": 100 },
              "size_fixed": 2
