            "drilldown": [],
            "mark_line": [],
            "connect_nulls": false,
            "no_value_replacement": "",
            "wrap_table_cells": false
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT SUM(duration)/1000000.0/60.0 as \"y_axis_1\" FROM \"default\" WHERE coding_segment_kind IS NOT NULL",
              "vrlFunctionQuery": "",
              "customQuery": true,
              "fields": {
                "stream": "default",
                "stream_type": "traces",
                "x": [],
                "y": [
                  {
                    "label": "Minutes",
                    "alias": "y_axis_1",
                    "column": "duration",
                    "color": "#53a751",
                    "aggregationFunction": "sum",
                    "sortBy": "DESC",
                    "isDerived": false
                  }
                ],
                "z": [],
                "breakdown": [],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": "",
                "layer_type": "scatter",
                "weight_fixed": 1,
                "limit": 0,
                "min": 0,
                "max": 100
              }
            }
          ],
          "layout": { "x": 0, "y": 0, "w": 12, "h": 12, "i": 1 },
          "htmlContent": "",
          "markdownContent": ""
